{
    "extends": [
        "react-app",
        "react-app/jest"
    ],
    "rules": {
        "no-unused-vars": "error",
        "no-console": "warn",
        "no-alert": "error",
        "jsx-quotes": ["error", "prefer-double"],
        "prefer-const": "error",
        "indent": ["error", 2],
        "no-restricted-imports": ["error", {
            "patterns": [".*"]
        }]
    }
}